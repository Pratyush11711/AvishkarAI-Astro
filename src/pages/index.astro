---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import '../styles/home.css';
---
<Layout
  page="index"
  title="Avishkar AI · AI call quality monitoring for 100% of calls"
  description="Avishkar AI scores 100% of contact centre calls. Verdicta automates call QA and agent scoring, Veritune flags churn risk. Start a free pilot."
  keywords="call quality monitoring, AI quality assurance, contact centre QA, speech analytics, conversation intelligence, call scoring software, churn prediction, agent coaching, BPO quality audit, India"
>
<!-- HERO -->
<section class="hero" id="hero">
  <canvas id="cord" aria-hidden="true"></canvas>
  <div class="wrap hero-in hl" id="heroIn">
    <Eyebrow class="fx" style="--d:.1s">Contact centre intelligence</Eyebrow>
    <h1 class="d1"><span class="ln"><span style="--i:0">Every call,</span></span><span class="ln"><span class="gr" style="--i:1">finally heard.</span></span></h1>
    <p class="lead fx" style="--d:.6s">Verdicta scores every agent. Veritune flags every customer about to leave. Both run on 100% of your calls, not the 2% your QA team has time for.</p>
    <div class="ctas fx" style="--d:.75s">
      <a class="btn" href="#start" data-label="Start a free pilot" data-mag></a>
      <a class="tl" href="#pilot">See how it works</a>
    </div>
  </div>
  <div class="cslot" id="cslot">
    <div class="hchips" aria-hidden="true">
      <div class="chip glass c1 floaty" style="--n:0"><div class="ch-h"><span><span class="aw sm" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Verdicta</span><span class="pill f">Fatal</span></div><div class="ch-b"><div><b id="hc1">83%</b><small>Call 00142 · QA score</small></div><div class="spark" id="spark"></div></div></div>
      <div class="chip glass c2 floaty" style="--n:1;animation-delay:-2s"><div class="ch-h"><span><span class="aw sm" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Veritune</span><span class="pill w">Competitor named</span></div><div class="ch-b"><div><b id="hc2">72%</b><small>Churn risk · Call 00287</small></div></div></div>
      <div class="chip glass c3 floaty" style="--n:2;animation-delay:-4s"><div class="ch-h"><span>Calls analysed today</span><span class="lab text-[9px]!">Live</span></div><div class="ch-b"><div><b id="hc3">12,480</b><small>Coverage 100%</small></div></div><div class="prog"><i style="--w:100%"></i></div></div>
    </div>
  </div>
  <div class="wrap"><div class="hero-ft fx" style="--d:1s">
    <div class="trust"><span><svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v6c0 4.2 3.2 7.8 7.5 9 4.3-1.2 7.5-4.8 7.5-9V6z"/></svg>ISO 27001 certified</span><span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>7 languages</span><span><svg viewBox="0 0 24 24"><path d="M7 18a4.5 4.5 0 1 1 .8-8.9A6 6 0 0 1 19 11a3.5 3.5 0 0 1-.5 7z"/></svg>Cloud or on-prem</span><span><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>No integration to start</span></div></div></div>
</section>

<!-- GAP -->
<section class="gap" id="gap">
  <div class="gap-st">
    <div class="wrap gap-in">
      <div>
        <Eyebrow>The sampling gap</Eyebrow>
        <div class="gap-num"><span id="gapN">3</span><small>%</small></div>
        <div class="gap-sw"><h2 class="d3 sA">Your QA team <mark class="hlw">only</mark> hears 1 to 5% of your calls.</h2><h2 class="d3 sB">Hear <span class="o">every single one</span> with Avishkar AI.</h2></div>
      </div>
      <div>
        <canvas id="dots" aria-label="A grid of 100 dots. Three are lit at first, then every dot lights up as you scroll." role="img"></canvas>
        <div class="gap-cap"><span class="lab">One dot, one call in a hundred</span><span class="lab" id="gapL">Sampled</span></div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS -->
<section class="sec" id="products">
  <div class="wrap">
    <div class="head rv">
      <Eyebrow>Products</Eyebrow>
      <h2 class="d2"><span class="ln"><span style="--i:0">Two products.</span></span><span class="ln"><span class="gr" style="--i:1">One dashboard.</span></span></h2>
    </div>
    <div class="pgrid">
      <div class="pcol">
        <article class="card up" data-liq id="c-verdicta" data-p="verdicta" tabindex="0" role="button" aria-label="Open Verdicta details" data-cursor="Open">
          <div class="art"></div><span class="num">01</span>
          <div class="card-meta"><div><Eyebrow as="span">Agent quality</Eyebrow><h3>Verdicta</h3></div><span class="opn"><svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12"/></svg></span></div>
        </article>
        <div class="pnote up">
          <p class="d4">Your own scorecard, applied to every call.</p>
          <div class="chipset"><span class="pill">20+ parameters</span><span class="pill">Fatal flags</span><span class="pill">AI summaries</span></div>
          <div class="row"><a class="tl" href="/verdicta">Explore Verdicta<svg viewBox="0 0 14 14"><path d="M4 10 10 4M5 4h5v5"/></svg></a><button class="more" data-open="verdicta">Quick view<i><svg viewBox="0 0 14 14"><path d="M7 2v10M2 7h10"/></svg></i></button></div>
        </div>
      </div>
      <div class="pcol">
        <div class="pnote up" style="--d:.15s">
          <p class="d4">Churn risk and competitor mentions, flagged before customers leave.</p>
          <div class="chipset"><span class="pill">Tone</span><span class="pill w">Churn risk</span><span class="pill">Next action</span></div>
          <div class="row"><a class="tl" href="/veritune">Explore Veritune<svg viewBox="0 0 14 14"><path d="M4 10 10 4M5 4h5v5"/></svg></a><button class="more" data-open="veritune">Quick view<i><svg viewBox="0 0 14 14"><path d="M7 2v10M2 7h10"/></svg></i></button></div>
        </div>
        <article class="card up" data-liq id="c-veritune" data-p="veritune" tabindex="0" role="button" aria-label="Open Veritune details" data-cursor="Open" style="--d:.15s">
          <div class="art"></div><span class="num">02</span>
          <div class="card-meta"><div><Eyebrow as="span">Customer signal</Eyebrow><h3>Veritune</h3></div><span class="opn"><svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12"/></svg></span></div>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- INSIDE -->
<section class="sec pt-[0]!" id="inside">
  <div class="wrap">
    <div class="head rv">
      <Eyebrow>Inside the product</Eyebrow>
      <h2 class="d2"><span class="ln"><span style="--i:0">Every call,</span></span><span class="ln"><span class="gr" style="--i:1">scored and explained.</span></span></h2>
      <div class="tabs" role="tablist" aria-label="Product view"><span class="tk" id="tk"></span><button role="tab" aria-selected="true" data-v="v1">Verdicta</button><button role="tab" aria-selected="false" data-v="v2">Veritune</button></div>
    </div>
    <div class="mock-st">
      <div class="mock" id="mock" data-cur="v1">
        <div class="mk-top"><span class="dts"><i></i><i></i><i></i></span><span class="url"><span class="aw sm" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="mkLoc"><b>Verdicta</b><em>/</em>Dashboard</span></span><span>Illustrative view</span></div>
        <div class="mk-shot" aria-hidden="true"><img class="v1 l" src="assets/img/mock/v1-l.webp" alt="" loading="lazy" decoding="async" width="2168" height="1192"><img class="v1 d" src="assets/img/mock/v1-d.webp" alt="" loading="lazy" decoding="async" width="2168" height="1192"><img class="v2 l" src="assets/img/mock/v2-l.webp" alt="" loading="lazy" decoding="async" width="2168" height="1122"><img class="v2 d" src="assets/img/mock/v2-d.webp" alt="" loading="lazy" decoding="async" width="2168" height="1122"></div>
        <div class="mk-body">
          <aside class="mk-side"><span class="lock"><svg class="mk"><use href="#mk"/></svg><span class="wd">Avishkar AI</span></span><nav class="mk-nav"><a class="on" data-sv="v1" role="button" tabindex="0"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.8"/></svg><span>Dashboard</span></a><a class="" data-sv="v3" role="button" tabindex="0"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5.8" rx="7" ry="2.6"/><path d="M5 5.8v12.4c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V5.8M5 12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6"/></svg><span>Campaigns</span></a><a class="" data-sv="v2" role="button" tabindex="0"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="m8.4 12.2 2.5 2.5 4.8-5"/></svg><span>Analyze results</span></a><a class="" data-sv="v4" role="button" tabindex="0"><svg viewBox="0 0 24 24"><circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5c.7-3 2.9-4.8 5.5-4.8s4.8 1.8 5.5 4.8M15.6 5.6a3 3 0 0 1 0 5.8M17.2 14.5c1.7.6 2.9 2.2 3.3 4.6"/></svg><span>User management</span></a><a class="" data-sv="v5" role="button" tabindex="0"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Settings</span></a></nav><a class="mk-out"><svg viewBox="0 0 24 24"><path d="M9.5 20.5H6a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h3.5M15.5 16.5 20 12l-4.5-4.5M20 12H9.5"/></svg><span>Logout</span></a></aside>
          <div class="mk-main">
            <div class="view" id="v1"><div class="vh"><div class="vh-t"><h4>Dashboard</h4><span class="pill">Verdicta</span></div><div class="vh-r"><span class="vchip">This week</span><span class="vbtn"><svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>Export</span></div></div>
              <div class="kpis"><div class="kpi"><span>Calls analysed</span><b>12,480</b></div><div class="kpi"><span>Average score</span><b>83%</b></div><div class="kpi"><span>Fatal flags</span><b class="o">41</b></div><div class="kpi"><span>Coaching due</span><b>17</b></div></div>
              <div class="mk-row">
                <div class="pane">
                  <div class="pane-h">Call 00142 <small>04:32 · Agent R. Mehta</small></div>
                  <div class="wave" id="wave1"><span class="ph"></span></div>
                  <div class="sc">
                    <div>Script adherence<span class="pill">Pass</span></div>
                    <div>Required disclosure<span class="pill f">Fatal</span></div>
                    <div>Dead air under 5 seconds<span class="pill">Pass</span></div>
                    <div>Hold under 60 seconds<span class="pill">Pass</span></div>
                    <div>CRM tagging<span class="pill">Pass</span></div>
                  </div>
                </div>
                <div class="pane">
                  <div class="pane-h">Overall achievement <small>This week</small></div>
                  <div class="gauge"><svg viewBox="0 0 100 100"><circle class="tr" cx="50" cy="50" r="44"/><circle class="pr" cx="50" cy="50" r="44" pathLength="100" data-v="17"/></svg><b>83<small>%</small></b></div>
                  <div class="pane-h m-[6px_0_0]!">Failures by parameter <small>Agents</small></div>
                  <div class="heat" id="heat"></div>
                </div>
              </div>
            </div>
            <div class="view" id="v2" hidden><div class="vh"><div class="vh-t"><h4>Analyze results</h4><span class="pill w">Veritune</span></div><div class="vh-r"><span class="vchip">Last 7 days</span><span class="vbtn"><svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>Export</span></div></div>
              <div class="kpis"><div class="kpi"><span>At-risk customers</span><b class="o">214</b></div><div class="kpi"><span>Competitor mentions</span><b>96</b></div><div class="kpi"><span>Calls escalated</span><b>38</b></div><div class="kpi"><span>Follow-ups due</span><b>58</b></div></div>
              <div class="mk-row">
                <div class="pane">
                  <div class="pane-h">Call 00287 <small>06:11 · Customer sentiment</small></div>
                  <div class="wave" id="wave2"><span class="ph"></span></div>
                  <div class="emo"><div class="n" style="--w:36%"></div><div class="m" style="--w:22%"></div><div class="h" style="--w:calc(42% - 6px)"></div></div>
                  <div class="emo-l"><span>Neutral</span><span>Concerned</span><span>Frustrated</span></div>
                  <div class="sc">
                    <div><span class="tm">00:42</span><span class="ev">Billing query raised</span><span class="pill">Neutral</span></div>
                    <div><span class="tm">02:41</span><span class="ev">Competitor named</span><span class="pill w">Flag</span></div>
                    <div><span class="tm">04:10</span><span class="ev">Asked about cancelling</span><span class="pill f">Critical</span></div>
                    <div><span class="tm">05:32</span><span class="ev">Complaint left open</span><span class="pill w">Flag</span></div>
                  </div>
                </div>
                <div class="pane">
                  <div class="pane-h">Churn risk <small>Confidence high</small></div>
                  <div class="gauge"><svg viewBox="0 0 100 100"><circle class="tr" cx="50" cy="50" r="44"/><circle class="pr o" cx="50" cy="50" r="44" pathLength="100" data-v="28"/></svg><b>72<small>%</small></b></div>
                  <div class="act"><span>Recommended action</span>Retention follow-up within 24 hours</div>
                  <div class="cbar"><div>Competitor A<s style="--w:.86"></s>41</div><div>Competitor B<s style="--w:.52"></s>25</div><div>Competitor C<s style="--w:.3"></s>14</div></div>
                </div>
              </div>
            </div><div class="view" id="v3" hidden><div class="vh"><div class="vh-t"><h4>Campaigns</h4><span class="pill">Verdicta + Veritune</span></div><div class="vh-r"><div class="seg" data-seg><button type="button" class="on" data-f="all">All</button><button type="button" data-f="live">Live</button><button type="button" data-f="paused">Paused</button></div><span class="vbtn dk"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New campaign</span></div></div><div class="kpis"><div class="kpi"><span>Live campaigns</span><b>5</b></div><div class="kpi"><span>Calls scored</span><b>11,534</b></div><div class="kpi"><span>Average QA score</span><b>81%</b></div><div class="kpi"><span>High-risk customers</span><b class="o">214</b></div></div><div class="pane tbl camp"><div class="tr th"><span>Campaign</span><span>Languages</span><span>Calls</span><span>QA score</span><span>Churn risk</span><span>Status</span></div><div class="tr st" data-st="live"><span class="cn"><i style="--c:var(--fg)"></i><span><b>Card activation</b><small>Inbound · Banking</small></span></span><span class="lg2">EN · ES</span><span class="num">3,214</span><span class="sbar"><s style="--w:0.88"></s><em>88%</em></span><span><span class="pill">Low</span></span><span><span class="stt on">Live</span></span></div><div class="tr st" data-st="live"><span class="cn"><i style="--c:var(--acc)"></i><span><b>Billing support</b><small>Inbound · Telecom</small></span></span><span class="lg2">EN</span><span class="num">2,870</span><span class="sbar"><s style="--w:0.79"></s><em>79%</em></span><span><span class="pill">Watch</span></span><span><span class="stt on">Live</span></span></div><div class="tr st" data-st="live"><span class="cn"><i style="--c:var(--fg)"></i><span><b>Retention desk</b><small>Outbound · Telecom</small></span></span><span class="lg2">EN · AR</span><span class="num">1,962</span><span class="sbar"><s style="--w:0.91"></s><em>91%</em></span><span><span class="pill f">High</span></span><span